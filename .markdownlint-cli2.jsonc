{
  "globs": [
    "CHANGELOG.md",
    ".agents/notes/**/*.md",
    "!.agents/notes/archived/**"
  ],
  "config": {
    "default": false,
    "MD013": {
      "line_length": 80,
      "heading_line_length": 80,
      "code_blocks": false,
      "tables": false,
      "strict": false,
      "stern": false
    }
  }
}
