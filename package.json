{
  "name": "dsh-subscriptions",
  "version": "0.1.5",
  "description": "Unified subscription providers and usage dashboard for DeepSeek Harness",
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodboys-ai/dsh-subscriptions.git"
  },
  "homepage": "https://github.com/goodboys-ai/dsh-subscriptions#readme",
  "bugs": {
    "url": "https://github.com/goodboys-ai/dsh-subscriptions/issues"
  },
  "packageManager": "pnpm@10.33.2",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "llm",
    "oauth",
    "chatgpt",
    "codex",
    "claude",
    "grok",
    "github-copilot",
    "google-antigravity",
    "cursor",
    "opencode-go",
    "kimi-code"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cursor-transport": {
      "types": "./vendor/cursor/index.d.ts",
      "default": "./vendor/cursor/index.js"
    },
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "vendor/cursor",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsdown",
    "test": "tsc -p tsconfig.test.json && node --import ./test/hermetic.mjs --test \"lib-test/test/**/*.spec.js\"",
    "test:mutation": "stryker run",
    "prepare": "tsdown -c tsdown.prepare.config.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-attachment": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-credentials": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-web": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.1.7-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-commands": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.7-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.7-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/dsh-web": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "fast-check": "^4.10.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
